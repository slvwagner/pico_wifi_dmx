#!/bin/sh
set -e

data_dir=/var/lib/pico-dmx-controller/data
backup_root=/var/lib/pico-dmx-controller/backups

if [ "$1" = upgrade ] && [ -d "$data_dir" ] &&
    find "$data_dir" -mindepth 1 -print -quit 2>/dev/null | grep -q .
then
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    backup_dir="$backup_root/before-@VERSION@-$timestamp"
    install -d -m 0750 "$backup_dir"
    cp -a "$data_dir/." "$backup_dir/"
fi

exit 0
