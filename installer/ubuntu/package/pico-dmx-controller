#!/usr/bin/env bash
set -euo pipefail

config_file=/etc/default/pico-dmx-controller
port=8090
if [[ -r "$config_file" ]]; then
    configured_port="$(sed -n 's/^PICO_DMX_PORT=\([0-9][0-9]*\)$/\1/p' "$config_file" | tail -n 1)"
    if [[ -n "$configured_port" ]]; then
        port="$configured_port"
    fi
fi
url="http://127.0.0.1:$port/"
shell_binary=/opt/pico-dmx-controller/shell/pico-dmx-controller-shell

if [[ -x "$shell_binary" ]]; then
    unset ELECTRON_RUN_AS_NODE
    if "$shell_binary" --url "$url"; then
        exit 0
    fi
fi

exec xdg-open "$url"
